# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

*storybook.log
storybook-static

# generated archives of the brand and design system folders (the folders themselves are tracked)
*.zip

# agent tooling that is installed per machine, including its platform binaries
/.agents/
/.codex/
/.do/
.claude/skills/*/scripts/bin/

# visual regression working output (the baseline in tests/visual/baseline IS tracked)
/tests/visual/tmp/

/.brand-dist/
