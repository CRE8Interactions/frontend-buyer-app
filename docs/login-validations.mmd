%% Step 0: login (email)
%% Source: app/login/page.tsx, lib/submitEmailValidation.ts, lib/fieldValidation.ts
%% Email required: Email address is required.
%% Email invalid: Email is invalid. Please try again.
%% Network: We're experiencing technical difficulties. Please try again later.

flowchart TD
  start[Step 0: email] --> typeEmail[Type email]
  typeEmail --> blurEmail{Blur a non-empty field?}
  blurEmail -->|yes| localBlur{emailBlurInvalid — blocked or bad syntax?}
  localBlur -->|yes| emailInvalid["Email is invalid. Please try again."]
  localBlur -->|no| noBlurErr[No error]
  blurEmail -->|empty| noBlurErr

  noBlurErr --> sendClick[Submit email]
  sendClick --> readDom[Read submitted email]
  readDom --> validate[validateSubmittedEmail]

  validate --> valFail{Result?}
  valFail -->|required| emailRequired["Email address is required."]
  valFail -->|invalid| emailInvalid
  valFail -->|network| network["We're experiencing technical difficulties. Please try again later."]
  valFail -->|ok| verifyUser[verifyUser send OTP]

  verifyUser --> verifyFail{Network error?}
  verifyFail -->|yes| network
  verifyFail -->|no| nextStep[Continue to Step 1: 6-digit code]

  subgraph validateSubmittedEmail [validateSubmittedEmail]
    vNorm[Trim and lowercase]
    vNorm --> vEmpty{Empty?}
    vEmpty -->|yes| vRequired[required]
    vEmpty -->|no| vBlocked{Blocked domain or bad syntax?}
    vBlocked -->|yes| vInvalid[invalid — SendGrid not called]
    vBlocked -->|no| vSendgrid[POST validateEmail]
    vSendgrid --> vSgNet{Network error?}
    vSgNet -->|yes| vNetwork[network]
    vSgNet -->|no| vSgVerdict{Invalid or Risky with suggestion?}
    vSgVerdict -->|yes| vInvalid
    vSgVerdict -->|no| vOk[ok]
  end

  validate -.-> validateSubmittedEmail
