%% Step 0: login (email)
%% Source: app/login/page.tsx and lib/fieldValidation.ts
%% Email required: Email address is required.
%% Email invalid: Email is invalid. Please try again.
%% Network: We're experiencing technical difficulties. Please try again later.

flowchart TD
  start[Shopper opens /login] --> emailStep[Step 0: email]

  emailStep --> typeEmail[Type email]
  typeEmail --> blurEmail{Leave a non-empty field?}
  blurEmail -->|yes| localEmail{Blocked or bad syntax?}
  localEmail -->|yes| emailInvalid["Email is invalid. Please try again."]
  localEmail -->|no| readySend[Send my code stays clickable]
  blurEmail -->|empty or still focused| readySend

  readySend --> sendClick[Click Send my code or press Enter]
  sendClick --> readDom[Read the value currently in the field]
  readDom --> normalize[Trim and lowercase]

  normalize --> emptyCheck{Empty?}
  emptyCheck -->|yes| emailRequired["Email address is required."]
  emptyCheck -->|no| syntaxCheck{Blocked or bad syntax?}
  syntaxCheck -->|yes| emailInvalid
  syntaxCheck -->|no| sendgrid[POST validateEmail]

  sendgrid --> sgFail{Network error?}
  sgFail -->|yes| network["We're experiencing technical difficulties. Please try again later."]
  sgFail -->|no| sgVerdict{Invalid or Risky with suggestion?}
  sgVerdict -->|yes| emailInvalid
  sgVerdict -->|no| verifyUser[verifyUser send OTP]
  verifyUser --> verifyFail{Network error?}
  verifyFail -->|yes| network
  verifyFail -->|no| nextStep[Continue to Step 1: 6-digit code]
