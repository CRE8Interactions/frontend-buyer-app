%% Wallet transfer flows (tickets + season/access passes)
%% Source: components/organisms/SeasonTickets.tsx, lib/submitEmailValidation.ts, lib/fieldValidation.ts
%%
%% Email required: Email address is required.
%% Email invalid: Email is invalid. Please try again.
%% Network: We're experiencing technical difficulties. Please try again later.
%% Self-transfer (tickets): You cannot transfer tickets to yourself.
%% Self-transfer (pass): This {season pass|access pass} is already assigned to your email.
%% Transfer API fail (tickets): We couldn't transfer those tickets. Please try again.
%% Transfer API fail (pass): Unable to transfer this {season pass|access pass}. Please try again.

flowchart TD
  subgraph ticketTransfer [Ticket transfer]
    tStep2[Step 2: recipient email] --> tBlur{Blur a non-empty field?}
    tBlur -->|yes| tLocalBlur{emailBlurInvalid — blocked or bad syntax?}
    tLocalBlur -->|yes| tEmailInvalid["Email is invalid. Please try again."]
    tLocalBlur -->|no| tNoBlurErr[No error]
    tBlur -->|empty| tNoBlurErr

    tNoBlurErr --> tSubmit[Submit email]
    tSubmit --> tValidate[validateSubmittedEmail]
    tValidate --> tValFail{Result?}
    tValFail -->|required| tEmailRequired["Email address is required."]
    tValFail -->|invalid| tEmailInvalid
    tValFail -->|network| tNetwork["We're experiencing technical difficulties. Please try again later."]
    tValFail -->|ok| tSelfCheck{Same as signed-in email?}
    tSelfCheck -->|yes| tSelfError["You cannot transfer tickets to yourself."]
    tSelfCheck -->|no| tStep3[Step 3: confirm]

    tStep3 --> tApi[createTicketTransfer]
    tApi --> tApiFail{Network or API error?}
    tApiFail -->|yes| tApiError["We couldn't transfer those tickets. Please try again."]
    tApiFail -->|no| tStep4[Step 4: success]
  end

  subgraph passTransfer [Pass transfer]
    pEmail[Step: recipient email] --> pBlur{Blur a non-empty field?}
    pBlur -->|yes| pLocalBlur{emailBlurInvalid — blocked or bad syntax?}
    pLocalBlur -->|yes| pEmailInvalid["Email is invalid. Please try again."]
    pLocalBlur -->|no| pNoBlurErr[No error]
    pBlur -->|empty| pNoBlurErr

    pNoBlurErr --> pSubmit[Submit email]
    pSubmit --> pValidate[validateSubmittedEmail]
    pValidate --> pValFail{Result?}
    pValFail -->|required| pEmailRequired["Email address is required."]
    pValFail -->|invalid| pEmailInvalid
    pValFail -->|network| pNetwork["We're experiencing technical difficulties. Please try again later."]
    pValFail -->|ok| pSelfCheck{Same as signed-in email?}
    pSelfCheck -->|yes| pSelfError["This pass is already assigned to your email."]
    pSelfCheck -->|no| pConfirm[Step: confirm]

    pConfirm --> pApi[createTicketTransfer accessPassId]
    pApi --> pApiFail{Network or API error?}
    pApiFail -->|yes| pPassApiError["Unable to transfer this pass. Please try again."]
    pApiFail -->|no| pSuccess[Step: success]
  end

  subgraph sharedEmail [validateSubmittedEmail]
    vNorm[Trim and lowercase]
    vNorm --> vEmpty{Empty?}
    vEmpty -->|yes| vRequired[required]
    vEmpty -->|no| vSyntax{Blocked or bad syntax?}
    vSyntax -->|yes| vInvalid[invalid]
    vSyntax -->|no| vSendgrid[POST validateEmail]
    vSendgrid --> vSgNet{Network error?}
    vSgNet -->|yes| vNetwork[network]
    vSgNet -->|no| vSgVerdict{Invalid or Risky with suggestion?}
    vSgVerdict -->|yes| vInvalid
    vSgVerdict -->|no| vOk[ok]
  end

  tValidate -.-> sharedEmail
  pValidate -.-> sharedEmail
