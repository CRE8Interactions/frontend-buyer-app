%% Step 1: code (OTP)
%% Source: app/login/page.tsx, lib/fieldValidation.ts
%% Code incorrect: Code is incorrect. Please try again
%% Network: We're experiencing technical difficulties. Please try again later.

flowchart TD
  codeStep[Step 1: 6-digit code] --> typeCode[Enter digits only, max 6]
  typeCode --> len6{Length is 6?}
  len6 -->|no| waitCode[Wait for 6 digits]
  waitCode --> typeCode
  len6 -->|yes| verifyCode[verifyCode automatically]

  verifyCode --> catchPath{Request failed?}
  catchPath -->|yes| codeSubmitErr[codeSubmitError]
  codeSubmitErr -->|"4xx except 408 and 429"| badCode["Code is incorrect. Please try again"]
  codeSubmitErr -->|"408, 429, 5xx, or no status"| codeNetwork["We're experiencing technical difficulties. Please try again later."]
  badCode --> codeStep
  codeNetwork --> codeStep

  catchPath -->|no| codeStatus{HTTP status}
  codeStatus -->|200 existing user| sessionOk[setSession and redirect]
  codeStatus -->|203 new user| nextStep[Continue to Step 2: create account]
  codeStatus -->|other| badCode

  codeStep --> resendClick[Send a new code]
  resendClick --> resendApi[verifyUser resend OTP]
  resendApi --> resendFail{Network error?}
  resendFail -->|yes| codeNetwork
  resendFail -->|no| resentOk[Success — no error message]
